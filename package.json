{
  "name": "aimless",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "description": "Go nowhere, on purpose. A walking app with no map. Zero dependencies by design.",
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "serve": "cd public && python3 -m http.server 8080",
    "icons": "node scripts/make-icons.mjs",
    "stamp": "node scripts/stamp-sw.mjs",
    "stamp:check": "node scripts/stamp-sw.mjs --check"
  }
}
